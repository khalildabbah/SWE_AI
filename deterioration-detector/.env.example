# Copy this file to .env and fill in your own values. .env is gitignored.

# MotherDuck access token (Settings -> Access Tokens in the MotherDuck UI).
# When set, the app reads the hosted cloud database instead of the local file.
MOTHERDUCK_TOKEN=

# Optional: cloud database name (defaults to "labs").
# MOTHERDUCK_DATABASE=labs

# OpenAI API key for the in-dashboard dataset chatbot (POST /api/chat) and the
# Syndrome Builder co-pilot (/api/builder/research). Get one at
# https://platform.openai.com/api-keys . Kept server-side only.
OPENAI_API_KEY=
# Optional: override the chatbot model (defaults to a fast, cheap model).
# OPENAI_MODEL=gpt-4o-mini
# Optional: model for the Syndrome Builder co-pilot. MUST support the hosted
# web_search tool (defaults to gpt-4o). Falls back to OPENAI_MODEL if unset.
# OPENAI_BUILDER_MODEL=gpt-4o
